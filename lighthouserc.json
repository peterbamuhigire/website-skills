{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 300,
          "throughputKbps": 1638,
          "cpuSlowdownMultiplier": 4,
          "requestLatencyMs": 0,
          "downloadThroughputKbps": 0,
          "uploadThroughputKbps": 0
        },
        "_comment_profile": "Blocking lab profile = low-end STRESS profile: WebPageTest '3G' preset network values (1.6 Mbps down, 300 ms RTT) with 4x CPU slowdown and Lighthouse's own mobile screen emulation (moto g power 2022, 412x823 @1.75). It is deliberately harsher than Lighthouse's default mobile throttling (1.6 Mbps, 150 ms RTT) and slower than every measured market figure in the register (UCC drive tests roughly 5-16 Mbps in Uganda, Aug-Sep 2024; SpeedOf.Me 8.4 Mbps, H1 2026; Kenya roughly 45-50 Mbps in secondary 2025 snapshots). It is a throttled Slow-4G/3G stress profile for the constrained tail, NOT a median. Uganda/Tanzania/Rwanda Ookla and Opensignal are NOT_ASSESSED. Sources and review dates: docs/source-registers/performance-currentness-2026-09-23.json and performance-currentness-2026-09-25.json; rationale: skills/launch-ops/deploy/references/africa-calibration.md"
      },
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/services/",
        "http://localhost:4321/about/",
        "http://localhost:4321/contact/",
        "http://localhost:4321/blog/"
      ]
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1.0
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 1500
          }
        ],
        "speed-index": [
          "warn",
          {
            "maxNumericValue": 3000
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 358400
          }
        ],
        "unused-javascript": [
          "warn",
          {
            "maxNumericValue": 20000
          }
        ],
        "unminified-javascript": "error",
        "unminified-css": "error",
        "image-delivery-insight": "error",
        "document-latency-insight": "error",
        "font-display-insight": "error",
        "render-blocking-insight": "warn",
        "lcp-discovery-insight": "warn",
        "network-dependency-tree-insight": "warn",
        "third-parties-insight": "warn",
        "legacy-javascript-insight": "warn",
        "duplicated-javascript-insight": "warn",
        "uses-responsive-images": "off",
        "modern-image-formats": "off",
        "efficient-animated-content": "off",
        "uses-text-compression": "off",
        "font-display": "off",
        "uses-rel-preconnect": "off",
        "uses-rel-preload": "off",
        "offscreen-images": "off",
        "third-party-summary": "off",
        "third-party-facades": "off",
        "prioritize-lcp-image": "off",
        "render-blocking-resources": "off",
        "legacy-javascript": "off",
        "duplicated-javascript": "off",
        "viewport-insight": "error",
        "dom-size-insight": "warn",
        "viewport": "off",
        "font-size": "off",
        "dom-size": "off",
        "lcp-lazy-loaded": "off",
        "lcp-phases-insight": "off",
        "interaction-to-next-paint-insight": "off",
        "no-document-write": "off",
        "uses-optimized-images": "off",
        "uses-passive-event-listeners": "off",
        "first-meaningful-paint": "off",
        "uses-long-cache-ttl": "off"
      },
      "_comment_assertions": "Assertions verified 2026-09-24 against real LHRs from Lighthouse 12.6.1 (bundled by @lhci/cli 0.15.1) and Lighthouse 13.5.0 with @lhci/cli assert: legacy audit ids that Lighthouse 13 removed are switched off and replaced by their performance-insight equivalents, so the gate works on both. INP is deliberately not asserted: Lighthouse navigation runs cannot measure it (enforce INP from field/RUM at p75)."
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./reports/lighthouse"
    }
  }
}
